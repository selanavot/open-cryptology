{
  // REQUIRE_ACCESS=1 keeps the site private: only requests that passed Cloudflare Access are served.
  // Set it to "0" (and remove the Access policy) to make the site public.
  "name": "open-cryptology",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "open-cryptology", "database_id": "18ccadd9-a999-4b68-8ba6-8db45cd0d5a3" }
  ],
  "r2_buckets": [
    { "binding": "PDFS", "bucket_name": "open-cryptology-pdfs" }
  ],
  // Contact form email (Cloudflare Email Routing). CONTACT_TO is a secret (.dev.vars locally,
  // `wrangler secret put CONTACT_TO` in production) and must be a verified destination address.
  // Metadata harvest every 4 hours (src/harvest.ts), kept rare to be polite to IACR.
  // Disable with HARVEST_ENABLED != "1".
  "routes": [
    { "pattern": "opencryptology.org", "custom_domain": true },
    { "pattern": "www.opencryptology.org", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 */4 * * *"] },
  "send_email": [{ "name": "MAILER" }],
  // Upload rate limit: 30 per minute per (salted) IP. Daily caps live in src/uploadguard.ts.
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "SITE_NAME": "Open Cryptology",
    "ISSUES_URL": "https://github.com/selanavot/open-cryptology/issues",
    "ORIGIN_BASE": "https://eprint.iacr.org",
    "CONTACT_FROM": "contact@opencryptology.org",
    "TURNSTILE_SITEKEY": "0x4AAAAAAF8BmDcmx1GIL55a",
    // Cloudflare Access for /review (maintainer only). ACCESS_AUD lists allowed Access app audience tags.
    "ACCESS_TEAM_DOMAIN": "fragrant-field-7a23.cloudflareaccess.com",
    "ACCESS_AUD": "bd600dd65d2bf3a6d35a8fc6100a53bbb8bcd4f920dee84d8422510ed839b911,5c5a332aefd1a1532265210b6452e66d78092dceca2034ebe44867464af87a26",
    "REQUIRE_ACCESS": "1",
    "HARVEST_ENABLED": "1"
  }
}
